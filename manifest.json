{
  "manifest_version": 3,
  "name": "Pinterest Auto-Descargador IA",
  "version": "1.2.0",
  "description": "Busca y descarga imágenes de Pinterest con 3 queries por escena, eligiendo la mejor coincidencia con heurística, detectores de texto/póster en Canvas y OCR local.",
  "permissions": ["storage", "downloads", "sidePanel", "unlimitedStorage"],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://*.pinimg.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://tessdata.projectnaptha.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pinterest Auto-Descargador"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["jszip.min.js", "tesseract.min.js", "blacklist_ia.json"],
      "matches": ["<all_urls>"]
    }
  ]
}